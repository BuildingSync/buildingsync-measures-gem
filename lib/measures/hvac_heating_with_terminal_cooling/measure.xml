  <class_name>HvacHeatingWithTerminalCooling</class_name>
  <display_name>Heating With Terminal Cooling HVAC</display_name>
  <description>Creates a heating source and cooling-only PTACs (single-speed DX) together in unserved zones.</description>
  <modeler_description>heating_source central_gas_furnace adds one shared constant-volume gas-furnace air loop that also supplies outdoor air, with PTACs that do not ventilate; hot_water_baseboard and electric_baseboard add a baseboard per zone; hot_water_ptac_coil puts a hot-water coil in each PTAC. Hot-water options add one boiler loop. Otherwise each PTAC heating coil is a zero-capacity, always-off placeholder.</modeler_description>
  <arguments>
    <argument>
      <name>operation</name>
      <display_name>Operation</display_name>
      <description>Only create is supported; the zones must be unserved apart from dedicated outdoor-air systems.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>create</default_value>
      <choices>
