  <class_name>ReplaceWithGroundSourceHeatPumpHvac</class_name>
  <display_name>Replace HVAC with Ground-Source Heat Pumps</display_name>
  <description>Replaces HVAC dedicated to selected zones with ground-coupled water-to-air heat pumps.</description>
  <modeler_description>Rejects partial shared-loop removal, preserves existing plants, and creates Ground Source Heat Pumps.</modeler_description>
