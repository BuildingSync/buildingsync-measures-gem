  <class_name>CreateFourPipeFanCoilHvac</class_name>
  <display_name>Create Four-Pipe Fan Coil HVAC</display_name>
  <description>Adds four-pipe fan-coil units and their required plant infrastructure to unserved target zones.</description>
  <modeler_description>Uses openstudio-standards to create Fan Coil systems. Fails when selected zones already have zone HVAC or an air-loop connection.</modeler_description>
  <arguments>
    <argument>
      <name>target_zone_names</name>
      <display_name>Target Zone Names</display_name>
      <description>Comma-separated exact thermal-zone names. Blank selects all thermal zones.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
      <default_value></default_value>
    </argument>
    <argument>
      <name>standards_template</name>
      <display_name>Standards Template</display_name>
      <description>openstudio-standards template used to construct the four-pipe fan-coil system.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>90.1-2019</default_value>
      <choices>
        <choice>
          <value>90.1-2013</value>
          <display_name>90.1-2013</display_name>
        </choice>
        <choice>
          <value>90.1-2016</value>
