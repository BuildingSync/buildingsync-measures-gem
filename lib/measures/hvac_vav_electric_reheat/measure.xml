  <class_name>HvacVavElectricReheat</class_name>
  <display_name>VAV with Electric Reheat HVAC</display_name>
  <description>Creates built-up VAV with electric reheat or replaces HVAC dedicated to selected zones.</description>
  <modeler_description>Uses one VAV PFP Boxes synthesis path; replacement rejects partial shared-loop removal and preserves pre-existing plants.</modeler_description>
