  <class_name>ModifyExistingPlantEquipment</class_name>
  <display_name>Modify Existing Plant Equipment</display_name>
  <description>Sets one capacity or efficiency property on explicitly named boilers or chillers.</description>
  <modeler_description>Performs exact-name matching and changes only named BoilerHotWater or ChillerElectricEIR objects.</modeler_description>
  <arguments>
    <argument>
      <name>target_plant_equipment_names</name>
      <display_name>Target Plant Equipment Names</display_name>
      <description>Comma-separated exact OpenStudio boiler or chiller names.</description>
      <type>String</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>property</name>
      <display_name>Property</display_name>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>boiler_thermal_efficiency</default_value>
      <choices>
        <choice>
          <value>boiler_capacity_kw</value>
          <display_name>boiler_capacity_kw</display_name>
        </choice>
        <choice>
          <value>boiler_thermal_efficiency</value>
          <display_name>boiler_thermal_efficiency</display_name>
        </choice>
        <choice>
          <value>chiller_capacity_tons</value>
          <display_name>chiller_capacity_tons</display_name>
        </choice>
        <choice>
          <value>chiller_reference_cop</value>
          <display_name>chiller_reference_cop</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>value</name>
      <display_name>Value</display_name>
      <description>Capacity or efficiency in the units implied by property.</description>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>0.85</default_value>
    </argument>
  </arguments>
