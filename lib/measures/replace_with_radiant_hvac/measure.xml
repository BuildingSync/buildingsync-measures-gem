  <class_name>ReplaceWithRadiantHvac</class_name>
  <display_name>Replace HVAC with Low-Temperature Radiant</display_name>
  <description>Replaces HVAC dedicated to selected zones with hydronic low-temperature radiant heating and cooling.</description>
  <modeler_description>Rejects partial shared-loop removal, preserves existing plants, and creates Radiant Slab equipment plus new supporting plants.</modeler_description>
  <arguments>
    <argument>
      <name>target_zone_names</name>
      <display_name>Target Zone Names</display_name>
      <description>Comma-separated exact thermal-zone names to replace.</description>
      <type>String</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>standards_template</name>
      <display_name>Standards Template</display_name>
      <description>openstudio-standards template used to construct the replacement Radiant Slab system.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>90.1-2019</default_value>
      <choices>
        <choice>
          <value>90.1-2013</value>
          <display_name>90.1-2013</display_name>
        </choice>
        <choice>
          <value>90.1-2016</value>
