  <class_name>ReplaceWithVavElectricReheatHvac</class_name>
  <display_name>Replace HVAC with VAV and Electric Reheat</display_name>
  <description>Replaces HVAC dedicated to selected zones with built-up VAV and electric-reheat terminals.</description>
  <modeler_description>Rejects partial shared-loop removal, preserves existing plants, and creates VAV PFP Boxes.</modeler_description>
