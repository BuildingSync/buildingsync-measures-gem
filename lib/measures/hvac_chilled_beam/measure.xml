  <class_name>HvacChilledBeam</class_name>
  <display_name>Chilled-Beam HVAC</display_name>
  <description>Creates chilled-beam systems in unserved zones or replaces HVAC dedicated to selected zones.</description>
  <modeler_description>Synthesizes supporting plants with temporary fan coils, then installs four-pipe beams and a primary-air loop.</modeler_description>
  <arguments>
