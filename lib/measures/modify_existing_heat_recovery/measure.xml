  <class_name>ModifyExistingHeatRecovery</class_name>
  <display_name>Modify Existing Heat Recovery</display_name>
  <description>Sets sensible or latent effectiveness on explicitly named air-to-air heat exchangers.</description>
  <modeler_description>Updates all 100% and 75% heating/cooling effectiveness fields for the selected metric.</modeler_description>
  <arguments>
    <argument>
      <name>target_heat_exchanger_names</name>
      <display_name>Target Heat Exchanger Names</display_name>
      <description>Comma-separated exact HeatExchangerAirToAirSensibleAndLatent names, or a JSON array of exact names (for names containing commas).</description>
      <type>String</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>effectiveness_metric</name>
      <display_name>Effectiveness Metric</display_name>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>sensible_effectiveness</default_value>
      <choices>
        <choice>
          <value>sensible_effectiveness</value>
          <display_name>sensible_effectiveness</display_name>
        </choice>
        <choice>
          <value>latent_effectiveness</value>
          <display_name>latent_effectiveness</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>effectiveness</name>
      <display_name>Effectiveness</display_name>
      <description>Fraction from 0 through 1.</description>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>0.7</default_value>
    </argument>
  </arguments>
