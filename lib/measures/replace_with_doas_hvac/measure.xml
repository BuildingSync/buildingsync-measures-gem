  <class_name>ReplaceWithDoasHvac</class_name>
  <display_name>Replace HVAC with a Dedicated Outdoor Air System</display_name>
  <description>Replaces HVAC dedicated to selected zones with a dedicated outdoor air system.</description>
  <modeler_description>Rejects partial shared-loop removal, preserves existing plants, and directly creates DOAS topology.</modeler_description>
