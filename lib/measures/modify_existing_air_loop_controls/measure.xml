  <class_name>ModifyExistingAirLoopControls</class_name>
  <display_name>Modify Existing Air Loop Controls</display_name>
  <description>Updates sizing supply-air temperatures and economizer controls on explicitly named air loops.</description>
  <modeler_description>Performs exact-name matching only. It does not infer HVAC type, add equipment, or alter topology.</modeler_description>
  <arguments>
    <argument>
      <name>target_air_loop_names</name>
      <display_name>Target Air Loop Names</display_name>
      <description>Comma-separated exact OpenStudio air-loop names.</description>
      <type>String</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>set_supply_air_temperatures</name>
      <display_name>Set Supply Air Temperatures</display_name>
      <type>Boolean</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>false</default_value>
      <choices>
        <choice>
          <value>true</value>
          <display_name>true</display_name>
        </choice>
        <choice>
          <value>false</value>
          <display_name>false</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>cooling_supply_air_temperature_c</name>
      <display_name>Cooling Supply Air Temperature (C)</display_name>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>12.8</default_value>
    </argument>
    <argument>
      <name>heating_supply_air_temperature_c</name>
      <display_name>Heating Supply Air Temperature (C)</display_name>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>32</default_value>
    </argument>
    <argument>
      <name>set_economizer</name>
      <display_name>Set Economizer</display_name>
      <type>Boolean</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>false</default_value>
      <choices>
        <choice>
          <value>true</value>
          <display_name>true</display_name>
        </choice>
        <choice>
          <value>false</value>
          <display_name>false</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>economizer_control_type</name>
      <display_name>Economizer Control Type</display_name>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>FixedDryBulb</default_value>
      <choices>
        <choice>
          <value>NoEconomizer</value>
          <display_name>NoEconomizer</display_name>
        </choice>
        <choice>
          <value>FixedDryBulb</value>
          <display_name>FixedDryBulb</display_name>
        </choice>
        <choice>
          <value>FixedEnthalpy</value>
          <display_name>FixedEnthalpy</display_name>
        </choice>
        <choice>
          <value>DifferentialDryBulb</value>
          <display_name>DifferentialDryBulb</display_name>
        </choice>
        <choice>
          <value>DifferentialEnthalpy</value>
          <display_name>DifferentialEnthalpy</display_name>
        </choice>
        <choice>
          <value>ElectronicEnthalpy</value>
          <display_name>ElectronicEnthalpy</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>economizer_high_limit_dry_bulb_temperature_c</name>
      <display_name>Economizer High Limit Dry Bulb (C)</display_name>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>24</default_value>
