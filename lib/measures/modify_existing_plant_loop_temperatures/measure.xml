  <class_name>ModifyExistingPlantLoopTemperatures</class_name>
  <display_name>Modify Existing Plant Loop Temperatures</display_name>
  <description>Sets the design loop exit temperature on explicitly named plant loops.</description>
  <modeler_description>Performs exact-name matching only and does not infer loop purpose from its name or connected system type.</modeler_description>
  <arguments>
    <argument>
      <name>target_plant_loop_names</name>
      <display_name>Target Plant Loop Names</display_name>
      <description>Comma-separated exact OpenStudio plant-loop names.</description>
      <type>String</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>design_loop_exit_temperature_c</name>
      <display_name>Design Loop Exit Temperature (C)</display_name>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>15.6</default_value>
    </argument>
  </arguments>
