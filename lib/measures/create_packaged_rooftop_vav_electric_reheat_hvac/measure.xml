  <class_name>CreatePackagedRooftopVavElectricReheatHvac</class_name>
  <display_name>Create Packaged Rooftop VAV with Electric Reheat</display_name>
  <description>Adds packaged rooftop VAV systems with parallel fan-powered electric-reheat terminals to unserved target zones.</description>
  <modeler_description>Uses the openstudio-standards PVAV PFP Boxes system and verifies that newly created air loops serve every selected zone.</modeler_description>
  <arguments>
    <argument>
      <name>target_zone_names</name>
      <display_name>Target Zone Names</display_name>
      <description>Comma-separated exact thermal-zone names. Blank selects all thermal zones.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
      <default_value></default_value>
    </argument>
    <argument>
      <name>standards_template</name>
      <display_name>Standards Template</display_name>
      <description>openstudio-standards template used to construct the PVAV PFP Boxes system.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>90.1-2019</default_value>
      <choices>
        <choice>
          <value>90.1-2013</value>
          <display_name>90.1-2013</display_name>
        </choice>
        <choice>
          <value>90.1-2016</value>
          <display_name>90.1-2016</display_name>
        </choice>
        <choice>
          <value>90.1-2019</value>
          <display_name>90.1-2019</display_name>
        </choice>
      </choices>
    </argument>
  </arguments>
