  <class_name>HvacVentilationOnly</class_name>
  <display_name>Ventilation-Only HVAC</display_name>
  <description>Creates ventilation-only air systems in unserved zones or replaces HVAC dedicated to selected zones.</description>
  <modeler_description>Directly constructs one ventilation-only topology; replacement rejects partial shared-loop removal and preserves plants.</modeler_description>
