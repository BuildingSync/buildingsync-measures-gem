  <class_name>CreateVrfHvac</class_name>
  <display_name>Create VRF HVAC</display_name>
  <description>Adds a variable-refrigerant-flow system to unserved target zones.</description>
  <modeler_description>Uses the openstudio-standards VRF system and verifies that newly created terminals serve every selected zone.</modeler_description>
  <arguments>
    <argument>
      <name>target_zone_names</name>
      <display_name>Target Zone Names</display_name>
      <description>Comma-separated exact thermal-zone names. Blank selects all thermal zones.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
      <default_value></default_value>
    </argument>
    <argument>
      <name>standards_template</name>
      <display_name>Standards Template</display_name>
      <description>openstudio-standards template used to construct the VRF system.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>90.1-2019</default_value>
      <choices>
        <choice>
          <value>90.1-2013</value>
          <display_name>90.1-2013</display_name>
        </choice>
        <choice>
