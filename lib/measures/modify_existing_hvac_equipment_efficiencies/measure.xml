  <class_name>ModifyExistingHvacEquipmentEfficiencies</class_name>
  <display_name>Modify Existing HVAC Equipment Efficiencies</display_name>
  <description>Sets one efficiency property on explicitly named existing HVAC components or equipment.</description>
  <modeler_description>Matches exact OpenStudio object names and applies only the selected supported setter. It never adds, removes, or infers HVAC systems.</modeler_description>
  <arguments>
    <argument>
      <name>target_object_names</name>
      <display_name>Target Object Names</display_name>
      <description>Comma-separated exact OpenStudio component or equipment names.</description>
      <type>String</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>efficiency_metric</name>
      <display_name>Efficiency Metric</display_name>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>dx_cooling_cop</default_value>
      <choices>
        <choice>
          <value>dx_cooling_cop</value>
          <display_name>dx_cooling_cop</display_name>
        </choice>
        <choice>
          <value>dx_heating_cop</value>
          <display_name>dx_heating_cop</display_name>
        </choice>
        <choice>
          <value>gas_burner_efficiency</value>
          <display_name>gas_burner_efficiency</display_name>
        </choice>
        <choice>
          <value>electric_heating_efficiency</value>
          <display_name>electric_heating_efficiency</display_name>
        </choice>
        <choice>
          <value>water_to_air_cooling_cop</value>
          <display_name>water_to_air_cooling_cop</display_name>
        </choice>
        <choice>
          <value>water_to_air_heating_cop</value>
          <display_name>water_to_air_heating_cop</display_name>
        </choice>
        <choice>
          <value>vrf_cooling_cop</value>
          <display_name>vrf_cooling_cop</display_name>
        </choice>
        <choice>
          <value>vrf_heating_cop</value>
          <display_name>vrf_heating_cop</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>efficiency_value</name>
      <display_name>Efficiency Value</display_name>
      <description>COP or fractional efficiency, according to efficiency_metric.</description>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>3.5</default_value>
    </argument>
  </arguments>
