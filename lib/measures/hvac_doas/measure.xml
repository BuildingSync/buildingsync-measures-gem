  <class_name>HvacDoas</class_name>
  <display_name>Dedicated Outdoor Air System HVAC</display_name>
  <description>Creates a dedicated outdoor-air system in unserved zones or replaces HVAC dedicated to selected zones.</description>
  <modeler_description>Directly constructs one DOAS topology; replacement rejects partial shared-loop removal and preserves plants.</modeler_description>
  <arguments>
    <argument>
      <name>operation</name>
      <display_name>Operation</display_name>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>create</default_value>
      <choices>
        <choice>
          <value>create</value>
          <display_name>create</display_name>
        </choice>
        <choice>
          <value>replace</value>
          <display_name>replace</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>target_zone_names</name>
      <display_name>Target Zone Names</display_name>
      <description>Comma-separated exact thermal-zone names. Blank selects all zones for create; replace requires explicit names.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
      <default_value></default_value>
    </argument>
    <argument>
      <name>standards_template</name>
      <display_name>Standards Template</display_name>
      <description>Workflow template recorded for consistency; direct construction does not query standards data.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>90.1-2019</default_value>
      <choices>
        <choice>
          <value>90.1-2013</value>
          <display_name>90.1-2013</display_name>
        </choice>
        <choice>
          <value>90.1-2016</value>
          <display_name>90.1-2016</display_name>
        </choice>
        <choice>
          <value>90.1-2019</value>
          <display_name>90.1-2019</display_name>
        </choice>
      </choices>
    </argument>
  </arguments>
