  <class_name>ReplaceWithPackagedRooftopVavElectricReheatHvac</class_name>
  <display_name>Replace HVAC with Packaged Rooftop VAV and Electric Reheat</display_name>
  <description>Replaces HVAC dedicated to selected zones with packaged rooftop VAV and electric-reheat terminals.</description>
  <modeler_description>Rejects partial shared-loop removal, preserves existing plant loops, and creates the PVAV PFP Boxes topology.</modeler_description>
  <arguments>
    <argument>
      <name>target_zone_names</name>
      <display_name>Target Zone Names</display_name>
      <description>Comma-separated exact thermal-zone names to replace.</description>
      <type>String</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>standards_template</name>
      <display_name>Standards Template</display_name>
      <description>openstudio-standards template used to construct replacement PVAV PFP Boxes systems.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>90.1-2019</default_value>
      <choices>
        <choice>
          <value>90.1-2013</value>
          <display_name>90.1-2013</display_name>
        </choice>
        <choice>
          <value>90.1-2016</value>
          <display_name>90.1-2016</display_name>
        </choice>
        <choice>
          <value>90.1-2019</value>
          <display_name>90.1-2019</display_name>
        </choice>
      </choices>
    </argument>
  </arguments>
