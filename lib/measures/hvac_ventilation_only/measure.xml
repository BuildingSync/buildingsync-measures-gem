  <class_name>HvacVentilationOnly</class_name>
  <display_name>Ventilation-Only HVAC</display_name>
  <description>Adds a ventilation-only air system to zones without air-loop service, or replaces the air loops serving selected zones. Zone equipment is kept.</description>
  <modeler_description>Directly constructs one ventilation-only topology; replacement rejects partial shared-loop removal and removes pre-existing plant loops left without loads.</modeler_description>
