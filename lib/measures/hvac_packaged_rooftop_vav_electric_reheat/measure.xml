  <class_name>HvacPackagedRooftopVavElectricReheat</class_name>
  <display_name>Packaged Rooftop VAV with Electric Reheat HVAC</display_name>
  <description>Creates packaged rooftop VAV with electric reheat or replaces HVAC dedicated to selected zones.</description>
  <modeler_description>Uses one PVAV PFP Boxes synthesis path; replacement rejects partial shared-loop removal and preserves plant loops.</modeler_description>
  <arguments>
    <argument>
      <name>operation</name>
      <display_name>Operation</display_name>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>create</default_value>
      <choices>
        <choice>
          <value>create</value>
          <display_name>create</display_name>
        </choice>
        <choice>
          <value>replace</value>
          <display_name>replace</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>target_zone_names</name>
      <display_name>Target Zone Names</display_name>
      <description>Comma-separated exact thermal-zone names. Blank selects all zones for create; replace requires explicit names.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
      <default_value></default_value>
    </argument>
    <argument>
      <name>standards_template</name>
      <display_name>Standards Template</display_name>
