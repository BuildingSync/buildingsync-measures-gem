  <class_name>HvacVrf</class_name>
  <display_name>VRF HVAC</display_name>
  <description>Creates VRF systems in unserved zones or replaces HVAC dedicated to selected zones.</description>
  <modeler_description>Uses one VRF synthesis path; replacement rejects partial shared air-loop and VRF outdoor-unit removal. Replacement removes pre-existing plant loops left without loads.</modeler_description>
  <arguments>
    <argument>
      <name>operation</name>
      <display_name>Operation</display_name>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>create</default_value>
      <choices>
        <choice>
          <value>create</value>
          <display_name>create</display_name>
        </choice>
        <choice>
          <value>replace</value>
          <display_name>replace</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>target_zone_names</name>
      <display_name>Target Zone Names</display_name>
      <description>Comma-separated exact thermal-zone names, or a JSON array of exact names (for names containing commas). Blank selects all zones for create; replace requires explicit names.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
      <default_value></default_value>
    </argument>
    <argument>
      <name>standards_template</name>
      <display_name>Standards Template</display_name>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
