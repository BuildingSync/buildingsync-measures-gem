  <class_name>HvacFourPipeFanCoil</class_name>
  <display_name>Four-Pipe Fan Coil HVAC</display_name>
  <description>Creates four-pipe fan coils in unserved zones or replaces HVAC dedicated to selected zones.</description>
  <modeler_description>Uses one synthesis path for both operations; replacement rejects partial shared-air-loop removal and preserves pre-existing plant loops.</modeler_description>
  <arguments>
