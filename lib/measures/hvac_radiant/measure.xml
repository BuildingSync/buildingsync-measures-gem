  <class_name>HvacRadiant</class_name>
  <display_name>Low-Temperature Radiant HVAC</display_name>
  <description>Creates hydronic radiant systems in unserved zones or replaces HVAC dedicated to selected zones.</description>
  <modeler_description>Uses the Radiant Slab topology and requires modeled surfaces before either operation mutates the model. Replacement removes pre-existing plant loops left without loads.</modeler_description>
