  <class_name>CreateVavElectricReheatHvac</class_name>
  <display_name>Create VAV with Electric Reheat</display_name>
  <description>Adds built-up VAV systems with parallel fan-powered electric-reheat terminals to unserved target zones.</description>
  <modeler_description>Uses openstudio-standards VAV PFP Boxes and verifies newly created air-loop coverage.</modeler_description>
  <arguments>
    <argument>
      <name>target_zone_names</name>
      <display_name>Target Zone Names</display_name>
      <description>Comma-separated exact thermal-zone names. Blank selects all thermal zones.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
      <default_value></default_value>
    </argument>
    <argument>
      <name>standards_template</name>
      <display_name>Standards Template</display_name>
      <description>openstudio-standards template used to construct VAV PFP Boxes.</description>
